# FairSplit AI — LLM Provider Configuration
# Copy this file to .env and fill in your API key.

# ═══════════════════════════════════════════════════════════════
# RECOMMENDED: Google Gemini (FREE — no credit card needed)
# Get your free key at: https://aistudio.google.com/apikey
# ═══════════════════════════════════════════════════════════════
GOOGLE_API_KEY=your-google-api-key-here

# LLM Provider: "gemini" (default, free) | "anthropic" | "openai"
# If not set, auto-detects based on which key is available.
# LLM_PROVIDER=gemini

# ─── Optional: Anthropic (paid) ───
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Optional: OpenAI (paid) ───
# OPENAI_API_KEY=your-openai-api-key-here
